APP_NAME="MR Biblioteca"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

# R.N.F. 03 – custo do bcrypt (mínimo 10)
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados (os valores abaixo são usados pelo docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=biblioteca_db
DB_USERNAME=biblioteca
DB_PASSWORD=biblioteca
DB_ROOT_PASSWORD=root

# R.N.F. 04 – sessão expira após 120 minutos de inatividade
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# E-mail: no Docker, as mensagens ficam visíveis no Mailpit (http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="biblioteca@empresa.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# RN04 – domínio aceito no autocadastro
BIBLIOTECA_DOMINIO_EMAIL=empresa.com.br
